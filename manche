import pygame
import sys

pygame.init()

WIDTH = 800
HEIGHT = 600

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("MORGHABE GAME")

font = pygame.font.SysFont(None, 60)
small_font = pygame.font.SysFont(None, 45)

WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GREEN = (0, 200, 80)
YELLOW = (255, 220, 0)

clock = pygame.time.Clock()

playing = False
words = []

button = pygame.Rect(300, 250, 200, 100)

while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if event.type == pygame.MOUSEBUTTONDOWN:
            if button.collidepoint(event.pos):
                playing = True

    screen.fill(BLACK)

    if not playing:
        pygame.draw.rect(screen, GREEN, button, border_radius=20)

        text = font.render("PLAY", True, WHITE)
        screen.blit(
            text,
            (
                button.centerx - text.get_width() // 2,
                button.centery - text.get_height() // 2
            )
        )

    else:
        words.append("morghabe")

        y = 20

        for word in words[-10:]:
            text = small_font.render(word, True, YELLOW)
            screen.blit(text, (20, y))
            y += 55

        if len(words) > 1000:
            words = words[-500:]

    pygame.display.update()
    clock.tick(10)
